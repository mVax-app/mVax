<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="40dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/calender_LV_patient_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textStyle="bold"
        android:textSize="22sp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/calendar_LV__title_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_date"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <Space
            android:layout_height="match_parent"
            android:layout_width="5dp" />

        <TextView
            android:id="@+id/calendar_LV__date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MM/DD/YYYY"
            android:textSize="18sp"/>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/calendar_LV_title_vaccine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_vaccine"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <Space
            android:layout_height="match_parent"
            android:layout_width="10sp" />

        <TextView
            android:id="@+id/calendar_LV_vaccine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vaccine"
            android:textSize="18sp"/>
    </LinearLayout>



</LinearLayout>